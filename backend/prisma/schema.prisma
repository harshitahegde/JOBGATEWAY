datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
  resumes       Resume[]
  resumeVersions ResumeVersion[]
  analyses      ResumeAnalysis[]
  userSkills    UserSkill[]
  savedJobs     SavedJob[]
  applications  Application[]
  outreachEmails OutreachEmail[]
  videos        Video[]
  videoAttachments ResumeVideoAttachment[]
  notifications Notification[]
}

model Profile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  fullName          String
  phone             String?
  location          String?
  bio               String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  leetcodeUrl       String?
  careerPreferences String?  // Stored as JSON string
  education         String?  // Stored as JSON string
  experience        String?  // Stored as JSON string
  projects          String?  // Stored as JSON string
  certifications    String?  // Stored as JSON string
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id               Int             @id @default(autoincrement())
  userId           Int
  title            String
  originalFilename String
  filePath         String
  fileType         String
  parsedContent    String?         // Stored as JSON string
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         ResumeVersion[]
  analyses         ResumeAnalysis[]
  videoAttachments ResumeVideoAttachment[]
}

model ResumeVersion {
  id             Int          @id @default(autoincrement())
  resumeId       Int
  userId         Int
  versionName    String
  targetJobTitle String?
  targetCompany  String?
  content        String       // Stored as JSON string
  createdAt      DateTime     @default(now())
  resume         Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]
  videoAttachments ResumeVideoAttachment[]
}

model ResumeAnalysis {
  id              Int      @id @default(autoincrement())
  userId          Int
  resumeId        Int?
  jobTitle        String
  company         String?
  jobDescription  String
  atsScore        Float
  matchedKeywords String?  // JSON string
  missingKeywords String?  // JSON string
  suggestions     String?  // JSON string
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
}

model Skill {
  id       Int    @id @default(autoincrement())
  name     String @unique
  category String @default("Technical")
}

model UserSkill {
  id               Int    @id @default(autoincrement())
  userId           Int
  skillName        String
  proficiencyLevel String @default("Intermediate")
  yearsExperience  Int    @default(1)
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

model Job {
  id              Int         @id @default(autoincrement())
  title           String
  company         String
  location        String
  type            String      @default("Full-Time")
  experienceLevel String      @default("Entry-Level")
  salaryRange     String?
  description     String
  requirements    String?     // JSON array string
  applicationUrl  String?
  source          String      @default("Internal")
  createdAt       DateTime    @default(now())
  savedJobs       SavedJob[]
  jobSkills       JobSkill[]
  applications    Application[]
}

model JobSkill {
  id         Int     @id @default(autoincrement())
  jobId      Int
  skillName  String
  isRequired Boolean @default(true)
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model SavedJob {
  id      Int      @id @default(autoincrement())
  userId  Int
  jobId   Int
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id              Int                      @id @default(autoincrement())
  userId          Int
  jobId           Int?
  externalJobId   String?
  companyName     String
  jobTitle        String
  location        String?
  jobUrl          String?
  status          String                   @default("SAVED") // SAVED, APPLIED, ASSESSMENT, INTERVIEW, OFFER, REJECTED, WITHDRAWN
  appliedDate     String?
  resumeVersionId Int?
  outreachEmailId Int?
  videoId         Int?
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resumeVersion   ResumeVersion?           @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  outreachEmails  OutreachEmail[]
  statusHistory   ApplicationStatusHistory[]
}

model Recruiter {
  id             Int             @id @default(autoincrement())
  companyName    String
  name           String
  title          String?
  email          String
  linkedinUrl    String?
  verified       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  outreachEmails OutreachEmail[]
}

model OutreachEmail {
  id                Int          @id @default(autoincrement())
  userId            Int
  applicationId     Int?
  recruiterId       Int?
  type              String       @default("recruiter_outreach") // recruiter_outreach, job_application, referral_request, follow_up
  recipientEmail    String
  recipientName     String?
  companyName       String?
  jobTitle          String?
  subject           String
  body              String
  status            String       @default("DRAFT") // DRAFT, READY_TO_SEND, SENDING, SENT, FAILED
  providerMessageId String?
  failureReason     String?
  sentAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  recruiter         Recruiter?   @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
}

model Video {
  id              Int      @id @default(autoincrement())
  userId          Int
  title           String
  description     String?
  filePath        String
  durationSeconds Int      @default(0)
  fileSize        Int      @default(0)
  mimeType        String?  @default("video/webm")
  storageProvider String   @default("local_disk")
  cloudAssetId    String?  // Cloudinary public_id / persistent asset ID
  shareUrl        String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments     ResumeVideoAttachment[]
}

model ResumeVideoAttachment {
  id              Int            @id @default(autoincrement())
  userId          Int
  videoId         Int
  resumeId        Int?
  resumeVersionId Int?
  notes           String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  resume          Resume?        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([resumeVersionId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicationStatusHistory {
  id             Int         @id @default(autoincrement())
  applicationId  Int
  previousStatus String?
  newStatus      String
  notes          String?
  changedAt      DateTime    @default(now())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
