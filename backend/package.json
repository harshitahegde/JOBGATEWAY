{
  "name": "jobgateway-backend",
  "version": "1.0.0",
  "description": "JobGateway Smart Job Application System Express Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/setup_database.js && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:setup": "node scripts/setup_database.js",
    "db:export-sqlite": "ts-node scripts/migrate_sqlite_to_postgres.ts --export",
    "db:import-postgres": "ts-node scripts/migrate_sqlite_to_postgres.ts --import",
    "db:migrate-postgres": "ts-node scripts/migrate_sqlite_to_postgres.ts --all",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/nodemailer": "^8.0.2",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.12",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
